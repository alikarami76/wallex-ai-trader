# Copy to .env and fill in. Never commit the real file.
WALLEX_API_KEY=
WALLEX_SUBACCOUNT_ID=

# BoxAPI, OpenAI-compatible. Hackathon budget is $3 total.
# Default model: gpt-6-luna. Also allowed: gpt-5-mini, gpt-5.4-mini, gpt-5.6-sol, gpt-6-sol, gpt-6.1-sol.
# Temperature is omitted unless llm.send_temperature is true in config/default.yaml.
# The client bills usage.cost from the response when BoxAPI sends it.
# Call caps live in that file: max_llm_calls_per_hour, max_llm_calls_total, max_spend_usd.
LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
