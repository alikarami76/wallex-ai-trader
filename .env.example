# Copy to .env and fill in. Never commit the real file.
WALLEX_API_KEY=
WALLEX_SUBACCOUNT_ID=

# BoxAPI, OpenAI-compatible. Hackathon budget is $3 total; the bot stops at $2.50.
# Leave LLM_MODEL empty so config/default.yaml can route tiers:
#   routine/tier0 gpt-6-luna low, signal/tier1 gpt-6-luna medium, trade/tier2 gpt-6-sol high.
# Set LLM_MODEL only to pin every tier to one model (gpt-5-mini, gpt-5.4-mini, gpt-5.6-sol, gpt-6-luna, gpt-6-sol, gpt-6.1-sol).
# Temperature is omitted unless llm.send_temperature is true. reasoning_effort is retried without the field on HTTP 400.
# The client bills usage.cost. Caps: max_spend_usd, max_spend_usd_per_day, max_llm_calls_per_hour, max_llm_calls_total.
LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
LLM_API_KEY=
LLM_MODEL=
