# Copy to .env and fill in. Never commit the real file.
WALLEX_API_KEY=
WALLEX_SUBACCOUNT_ID=

# BoxAPI, OpenAI-compatible. Hackathon budget is $3 total.
# Other allowed models: gpt-5.4-mini, gpt-5.6-sol, gpt-6-sol, gpt-6.1-sol
# gpt-5-mini rejects temperature. The client omits it unless
# llm.send_temperature is true in config/default.yaml.
# Call caps live in that file: max_llm_calls_per_hour, max_llm_calls_total, max_spend_usd.
LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
