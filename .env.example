# Copy to .env and fill in. Never commit the real file.
WALLEX_API_KEY=
WALLEX_SUBACCOUNT_ID=

# BoxAPI, OpenRouter-like. Hackathon budget is $3 total; the bot stops at $2.50.
# LLM_MODEL is ignored. It must not pin every tier to one model.
# Optional per-tier overrides. Leave them unset to keep the config router:
#   routine/signal/trade = openai/gpt-6-luna, stakes = openai/gpt-6-sol.
# Bare ids (gpt-6-luna) also work; the client prefers the prefixed form.
# LLM_MODEL_CHEAP=gpt-6-luna
# LLM_MODEL_STRONG=gpt-6-sol
# Temperature is omitted unless llm.send_temperature is true.
# A completion cap is max_completion_tokens. gpt-6-luna rejects max_tokens.
# reasoning_effort is retried without the field on HTTP 400.
# The client bills usage.cost and logs a running total against $3. Do not use /key or /credits; they are a shared upstream account.
# Caps: max_spend_usd, max_spend_usd_per_day, max_llm_calls_per_hour, max_llm_calls_total.
LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
LLM_API_KEY=
LLM_MODEL=
# LLM_MODEL_CHEAP=
# LLM_MODEL_STRONG=

# Go-live flags. Off by default. Set them before the first live fill, then leave them.
# TRADER_LIVE_AUTHORIZED=1
# TRADER_EV_OVERRIDE=1

# Read-only desk on the health port. /health stays open. The page cannot send orders.
# Several users: a JSON object of username to password. Compared in constant time.
# DASHBOARD_USERS={"ada":"...","ben":"..."}
# Single-user fallback. The page stays closed when no user is configured.
# DASHBOARD_USER=
# DASHBOARD_PASSWORD=

# Optional Telegram alerts. Off when either variable is unset. Alert only:
# cycle gap over 5 minutes, HALT or KILLED, an order reject, a taker entry fill.
# TELEGRAM_ALERT_BOT_TOKEN=
# TELEGRAM_ALERT_CHAT_ID=
# Trade log. Same bot token, different chat. Unset means no trade posts.
# Gordon Trades is -1003898687684.
# TELEGRAM_TRADES_CHAT_ID=
# Sidecar tail. Off unless this is set. It does not place orders or write journals.
# WATCHDOG_ENABLED=
